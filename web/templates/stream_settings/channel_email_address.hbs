<div class="channel-email-address miatsuco-email-address-row" data-email-address-id="{{id}}" data-base-email="{{email}}">
    <div class="miatsuco-email-address-header">
        <span class="miatsuco-email-address-sender">{{sender_name}}</span>
        {{> ../components/action_button
          label=(t "Revoke")
          variant="subtle"
          intent="danger"
          custom_classes="miatsuco-revoke-email-address"
          }}
    </div>
    {{#if has_options}}
        <details class="miatsuco-email-address-options">
            <summary>{{t "Configuration options" }}</summary>
            <div class="miatsuco-email-address-option-list">
                <p class="question-which-parts">
                    {{t "Which parts of the emails should be included in the Zulip messages?"}}
                </p>
                {{#each tags}}
                    <div class="input-group">
                        <label class="checkbox">
                            <input class="tag-checkbox" id="{{this.id}}" data-option="{{this.name}}" type="checkbox" {{#if this.checked}}checked{{/if}}/>
                            <span class="rendered-checkbox"></span>
                        </label>
                        <label class="inline" for="{{this.id}}">{{this.description}}</label>
                    </div>
                {{/each}}
            </div>
        </details>
    {{/if}}
    {{#if address}}
        <div class="stream-email">
            <div class="email-address">{{address}}</div>
            <span class="copy-button tippy-zulip-tooltip copy-email-address" data-tippy-content="{{t 'Copy email address' }}">
                <i class="zulip-icon zulip-icon-copy"></i>
            </span>
        </div>
    {{/if}}
    <div class="miatsuco-email-address-meta">
        {{t "Created by {creator_name} on {created_date}." }}
    </div>
</div>
